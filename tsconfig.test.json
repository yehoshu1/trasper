{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2023"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": ".",
    "outDir": ".test-dist",
    "types": ["node"]
  },
  "include": ["tests/**/*.ts", "src/lib/**/*.ts", "src/generated/prisma/**/*.ts"],
  "exclude": ["node_modules", "tests/e2e", "src/lib/source.ts"]
}
