{
  "name": "trasper",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --webpack",
    "predev": "fumadocs-mdx",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "fumadocs-mdx",
    "prebuild": "fumadocs-mdx",
    "docs:generate": "fumadocs-mdx",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "version:check": "node scripts/check-version.mjs",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "backup": "node scripts/backup.mjs",
    "cron": "node scripts/cron.mjs",
    "logos:fetch": "node scripts/fetch-airline-logos.mjs",
    "docs:css": "node scripts/sync-docs-css.mjs",
    "postinstall": "node scripts/postinstall.mjs && node scripts/sync-docs-css.mjs"
  },
  "prisma": {
    "seed": "node scripts/seed.mjs"
  },
