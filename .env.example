# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
DATABASE_URL="file:./data/app.db"
# Public origin used for links, trusted origins and secure cookies.
APP_URL="http://localhost:3000"
# Hostname terminated by Caddy in docker-compose.prod.yml (not needed for bare Node).
APP_DOMAIN="localhost"
# IANA time zone for document dates, deadlines and reporting.
APP_TIMEZONE="UTC"
# Optional host port for docker-compose.dev.yml (default 3000).
# APP_PORT="3000"
# Optional product name used before Settings load, e.g. in the TOTP issuer.
APP_NAME="Trasper"
UPLOAD_DIR="./uploads"
LOG_LEVEL="info"

# Production image (docker-compose.prod.yml). APP_IMAGE_REPO is the repository
# without a tag. APP_IMAGE_TAG is the release tag without "v", an exact
# sha-<commit>, or "latest" when the platform pulls on every deploy. A stale
# tag here is the usual reason a redeploy still runs old code; /api/health
# reports the baked revision.
# APP_IMAGE_REPO="ghcr.io/<owner>/<repo>"
# APP_IMAGE_TAG="latest"

# REQUIRED in production: at least 32 random characters. Generate with:
#   openssl rand -base64 48
# Leaving it empty is only allowed in development.
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# First admin (created by `npm run db:seed`)
# ---------------------------------------------------------------------------
# Production requires an explicit password of at least 10 characters; the
# published development default is rejected. Use a password manager.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Initial company profile (used only when the database is first seeded)
# ---------------------------------------------------------------------------
# Everything here is editable later in Settings → Company. These variables
# simply let a deployment start with the agency's own identity instead of the
# neutral placeholders.
SEED_COMPANY_NAME="Your Travel Agency"
SEED_COMPANY_ADDRESS=""
SEED_COMPANY_EMAIL="hello@example.com"
SEED_COMPANY_PHONE=""
SEED_COMPANY_WEBSITE=""
SEED_COMPANY_TIN=""
SEED_COMPANY_FOOTER="Travel quotations, itineraries and pro forma invoices."

# Initial commercial defaults. Configure tax rules in Settings → VAT and taxes.
BASE_CURRENCY="USD"
VAT_ENABLED="false"
VAT_RATE_BPS="0"
VAT_REGISTRATION_NUMBER=""
VAT_LABEL="VAT"
PRICING_ROUNDING_UNIT="1"
PRICING_DEFAULT_MARGIN_BPS="1000"
PRICING_DEFAULT_VALIDITY_DAYS="1"
PRICING_RATE_MAX_AGE_DAYS="7"
# Presentation defaults: lump_sum | net_plus_fee | itemised | per_person | total_only
PRICING_DISPLAY="lump_sum"
# included | note | summary | itemised
PRICING_TAX_DISPLAY="included"
SERVICE_FEE_LABEL="Service fee"
TAX_LABEL="Taxes"
TOTAL_LABEL="Total"
PER_PERSON_LABEL="Price per person"
TAX_NOTE=""

# ---------------------------------------------------------------------------
# Transactional/system email (Resend)
# ---------------------------------------------------------------------------
# Used only for 2FA, recovery, password reset and staff invites — never for
# customer documents. Use a dedicated domain with its own SPF/DKIM records.
RESEND_API_KEY=""
SYSTEM_FROM_EMAIL="no-reply@example.com"
# Optional: overrides the company name in the From header.
SYSTEM_FROM_NAME=""

# ---------------------------------------------------------------------------
# Scheduled maintenance route (/api/cron) and the container timer
# ---------------------------------------------------------------------------
# REQUIRED in production: at least 16 random characters, sent as a Bearer
# token. Query-string secrets are rejected.
CRON_SECRET=""
# CRON_INTERVAL_SECONDS=900

# ---------------------------------------------------------------------------
# AI generation (optional)
# ---------------------------------------------------------------------------
# Set AI_PROVIDER=none to disable. The provider URL and key are managed in
# Settings → AI and stored encrypted in the database.
# Private/link-local provider URLs are blocked in production unless
# AI_ALLOW_PRIVATE_BASE_URL=1 is set for a deliberate local model server.
AI_PROVIDER="none"
AI_MODEL="gpt-4o-mini"
AI_API_KEY=""
# AI_BASE_URL=""
# AI_ALLOW_PRIVATE_BASE_URL="0"

# ---------------------------------------------------------------------------
# Backups (npm run backup)
# ---------------------------------------------------------------------------
BACKUP_DIR="./backups"
# BACKUP_REMOTE="/mnt/offsite/travel-quotation-backups"
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8
# BACKUP_KEEP_MONTHLY=12

# ---------------------------------------------------------------------------
# HTTPS (docker compose / Caddy)
# ---------------------------------------------------------------------------
# Address used for Let's Encrypt expiry notices. Caddy falls back to the
# public hostname's admin contact if this is empty.
ACME_EMAIL=""
